# ── Server ────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────
# Replace the placeholder below with your real connection string from:
# MongoDB Atlas → Clusters → Connect → Connect your application
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/revai?retryWrites=true&w=majority&appName=RevAI

# ── Gemini AI ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Production frontend URL ─────
# CLIENT_ORIGIN=https://your-production-domain.com
